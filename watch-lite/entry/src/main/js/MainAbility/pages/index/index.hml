<stack class="root" onswipe="swipeEvent">
<div if="{{view == 'home'}}" class="page">
<div class="brand"><text class="brand-main">PC REMOTE DECK</text><text class="brand-sub">FIT 4 PRO</text></div>
<div class="status-panel"><div class="status-row"><text class="label">PHONE</text><text class="ok">{{connectionState}}</text></div><div class="status-row"><text class="label">PC</text><text class="value">{{pcState}}</text></div><div class="status-row"><text class="label">BATTERY</text><text class="value">{{watchBattery}}%</text></div><div class="status-row"><text class="label">HR</text><text class="value">{{heartRate}} BPM</text></div></div>
<div class="quick-row"><input type="button" class="quick" value="LOCK" onclick="quickLock"/><input type="button" class="quick" value="MUTE" onclick="quickMute"/></div>
<div class="quick-row"><input type="button" class="quick" value="PLAY" onclick="quickPlay"/><input type="button" class="quick" value="SHOT" onclick="quickShot"/></div>
<div class="cat-row"><input type="button" class="cat" value="COMMAND" onclick="catCommand"/><input type="button" class="cat" value="BIO" onclick="catBio"/></div>
<div class="cat-row"><input type="button" class="cat" value="SPORT" onclick="catSport"/><input type="button" class="cat" value="FIELD" onclick="catField"/></div>
<div class="cat-row"><input type="button" class="cat" value="TACTICAL" onclick="catTactical"/><input type="button" class="cat" value="SYSTEM" onclick="catSystem"/></div>
<text class="footer">49 MODULES • 480x408 • SAFE FALLBACK</text></div>
<div if="{{showCommand}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">COMMAND</text><text class="mini">{{connectionState}}</text></div><list class="feature-list"><list-item class="feature-row"><input type="button" class="feature-btn" value="FAVORITES" onclick="f0"/><text class="source">PC</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="PC MONITOR" onclick="f1"/><text class="source">PC</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="NOW PLAYING" onclick="f2"/><text class="source">PC</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="AI LIMITS" onclick="f3"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="CONTEXT AWARE" onclick="f4"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="AIR MOUSE" onclick="f5"/><text class="source">PC</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="APP LAUNCHER" onclick="f6"/><text class="source">PC</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="D-PAD" onclick="f7"/><text class="source">PC</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="PRO TOOLS" onclick="f9"/><text class="source">PC</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="STREAM HUB" onclick="f11"/><text class="source">PC</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="NETWORK" onclick="f12"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="TERMINAL" onclick="f14"/><text class="source">PC</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="CAMERA PRO" onclick="f15"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="COMMAND SYSTEM" onclick="f21"/><text class="source">PC</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="PROTOCOLS" onclick="f23"/><text class="source">PC</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="MOTION COMMAND" onclick="f26"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="VOICE COMMAND" onclick="f31"/><text class="source">PHONE</text></list-item></list></div><div if="{{showBio}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">BIO</text><text class="mini">{{connectionState}}</text></div><list class="feature-list"><list-item class="feature-row"><input type="button" class="feature-btn" value="DAILY HUB" onclick="f13"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="BIO TELEMETRY" onclick="f22"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="MORNING DIAGNOSTIC" onclick="f32"/><text class="source">PHONE</text></list-item></list></div><div if="{{showSport}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">SPORT</text><text class="mini">{{connectionState}}</text></div><list class="feature-list"><list-item class="feature-row"><input type="button" class="feature-btn" value="AQUA RECON" onclick="f33"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="RUN ANALYZER" onclick="f34"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="TACTICAL CADDIE" onclick="f35"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="SPORTS HUD" onclick="f38"/><text class="source">PHONE</text></list-item></list></div><div if="{{showField}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">FIELD</text><text class="mini">{{connectionState}}</text></div><list class="feature-list"><list-item class="feature-row"><input type="button" class="feature-btn" value="NAVIGATION" onclick="f17"/><text class="source">WATCH+PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="WI-FI RECON" onclick="f39"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="FIELD SYSTEMS" onclick="f40"/><text class="source">WATCH+PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="BREADCRUMB" onclick="f41"/><text class="source">WATCH+PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="GEO ANCHOR" onclick="f42"/><text class="source">WATCH+PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="SOLAR SENTINEL" onclick="f43"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="THERMAL LOAD" onclick="f44"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="ALTITUDE SENTINEL" onclick="f45"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="TRANSIT GUARDIAN" onclick="f46"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="SKY SCANNER" onclick="f47"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="EMERGENCY CORE" onclick="f48"/><text class="source">WATCH+PHONE</text></list-item></list></div><div if="{{showTactical}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">TACTICAL</text><text class="mini">{{connectionState}}</text></div><list class="feature-list"><list-item class="feature-row"><input type="button" class="feature-btn" value="ATMOSPHERIC" onclick="f19"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="ACOUSTIC" onclick="f20"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="TACTICAL" onclick="f24"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="TACTICAL NAV" onclick="f27"/><text class="source">WATCH+PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="SILENT NAV" onclick="f28"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="DEPTH HUD" onclick="f29"/><text class="source">UNAVAILABLE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="TACTICAL LIGHT" onclick="f30"/><text class="source">WATCH</text></list-item></list></div><div if="{{showSystem}}" class="page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goHome"/><text class="title">SYSTEM</text><text class="mini">{{connectionState}}</text></div><list class="feature-list"><list-item class="feature-row"><input type="button" class="feature-btn" value="SMART ROOM" onclick="f8"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="SYSTEM" onclick="f10"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="SMART WALLET" onclick="f16"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="ASSET RADAR" onclick="f18"/><text class="source">PHONE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="SYSTEM LOG" onclick="f25"/><text class="source">WATCH</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="LIGHT SCANNER" onclick="f36"/><text class="source">UNAVAILABLE</text></list-item><list-item class="feature-row"><input type="button" class="feature-btn" value="POWER CORE" onclick="f37"/><text class="source">WATCH</text></list-item></list></div>
<div if="{{view == 'lightRed'}}" class="light-red"><text class="light-title">TACTICAL RED</text><text class="light-sub">SCREEN LIGHT</text><input type="button" class="light-stop" value="STOP" onclick="stopLight"/></div><div if="{{view == 'lightWhite'}}" class="light-white"><text class="light-title dark-text">WHITE LIGHT</text><text class="light-sub dark-text">SCREEN LIGHT</text><input type="button" class="light-stop" value="STOP" onclick="stopLight"/></div><div if="{{view == 'lightBlack'}}" class="light-black"><text class="light-title red-text">SOS</text><text class="light-sub red-text">FLASHING</text><input type="button" class="light-stop" value="STOP SOS" onclick="stopLight"/></div><div if="{{view == 'detail'}}" class="page detail-page"><div class="topbar"><input type="button" class="back" value="&lt;" onclick="goList"/><text class="title">{{selectedTitle}}</text><text class="mini">{{selectedSource}}</text></div><div class="detail-card"><text class="detail-desc">{{selectedDesc}}</text><div class="metric-row"><text class="label">STATE</text><text class="ok">{{featureState}}</text></div><div class="metric-row"><text class="label">SOURCE</text><text class="value">{{selectedSource}}</text></div><div class="metric-row"><text class="label">DATA</text><text class="value small-value">{{featureData}}</text></div></div><input if="{{action1Label != ''}}" type="button" class="action" value="{{action1Label}}" onclick="detailAction1"/><input if="{{action2Label != ''}}" type="button" class="action" value="{{action2Label}}" onclick="detailAction2"/><input if="{{action3Label != ''}}" type="button" class="action" value="{{action3Label}}" onclick="detailAction3"/><input if="{{action4Label != ''}}" type="button" class="action danger" value="{{action4Label}}" onclick="detailAction4"/><text class="message">{{message}}</text></div>
</stack>

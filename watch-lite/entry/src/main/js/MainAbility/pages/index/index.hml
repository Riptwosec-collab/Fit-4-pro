<stack class="root" onswipe="swipeEvent">
  <div class="grid-layer"></div>
  <div class="scan-beam"></div>

  <div if="{{view == 'home'}}" class="page masterpiece-page">
    <div class="system-status-strip">
      <div class="status-cell"><text class="status-dot online">●</text><text class="status-label">PC</text></div>
      <div class="status-cell"><text class="status-dot online">●</text><text class="status-label">PHONE</text></div>
      <div class="status-cell"><text class="status-dot online">●</text><text class="status-label">NET</text></div>
      <text class="battery-mini">{{watchBattery}}%</text>
    </div>
    <div class="header">
      <text class="time-display">{{clockText}}</text>
      <div class="status-area"><text class="status-title">STATUS</text><text class="status-secure">{{connectionState}}</text></div>
    </div>
    <div class="page-header home-header"><text class="page-title">PC REMOTE DECK</text><div class="subtitle-row"><div class="subtitle-line"></div><text class="page-subtitle">{{contextProfile}} • {{activeApp}}</text><div class="subtitle-line"></div></div></div>

    <div class="home-core">
      <div class="volume-dial"><div class="volume-ticks"></div><div class="volume-active-clip"><div class="volume-active-ring"></div></div><div class="volume-core"><text class="volume-value">{{masterVolume}}</text><text class="volume-unit">%</text></div></div>
      <div class="home-stats"><div class="stat"><text class="stat-k">CPU</text><text class="stat-v">{{cpu}}</text></div><div class="stat"><text class="stat-k">RAM</text><text class="stat-v">{{ram}}</text></div><div class="stat"><text class="stat-k">PING</text><text class="stat-v">{{ping}}</text></div><div class="stat"><text class="stat-k">LINK</text><text class="stat-v small">{{quality}}</text></div></div>
    </div>
    <div class="eq-row"><div class="eq-bar e1"></div><div class="eq-bar e2"></div><div class="eq-bar e3"></div><div class="eq-bar e4"></div><div class="eq-bar e5"></div><div class="eq-bar e6"></div><div class="eq-bar e7"></div></div>
    <div class="dynamic-grid"><input type="button" class="dyn-btn active-state" value="{{dynamic1Label}}" onclick="dynamic1"/><input type="button" class="dyn-btn" value="{{dynamic2Label}}" onclick="dynamic2"/><input type="button" class="dyn-btn" value="{{dynamic3Label}}" onclick="dynamic3"/><input type="button" class="dyn-btn" value="{{dynamic4Label}}" onclick="dynamic4"/></div>
    <div class="quick-grid"><input type="button" class="quick-btn" value="PLAY" onclick="quickPlay"/><input type="button" class="quick-btn" value="MUTE" onclick="quickMute"/><input type="button" class="quick-btn" value="SHOT" onclick="quickShot"/><input type="button" class="quick-btn" value="LOCK" onclick="quickLock"/></div>
    <div class="dock-wrapper"><div class="dock-scroll"><input type="button" class="dock-item active" value="★" onclick="goHome"/><input type="button" class="dock-item" value="HUB" onclick="f54"/><input type="button" class="dock-item" value="CPU" onclick="f1"/><input type="button" class="dock-item" value="MOU" onclick="f5"/><input type="button" class="dock-item" value="APP" onclick="catApps"/><input type="button" class="dock-item" value="WIN" onclick="f50"/><input type="button" class="dock-item" value="AUD" onclick="f49"/><input type="button" class="dock-item" value="MAC" onclick="f51"/><input type="button" class="dock-item" value="NET" onclick="catNetwork"/><input type="button" class="dock-item" value="SYS" onclick="catSystem"/></div></div>
  </div>

  <div if="{{view == 'list'}}" class="page masterpiece-page">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">PC</text></div><text class="status-label">{{category}}</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="goHome"/><div class="status-area"><text class="status-title">STATUS</text><text class="status-secure">{{pcState}}</text></div></div>
    <div class="page-header compact-header"><text class="page-title">{{category}}</text><div class="subtitle-row"><div class="subtitle-line"></div><text class="page-subtitle">REMOTE DECK MODULES</text><div class="subtitle-line"></div></div></div>
    <div class="category-summary"><div class="summary-cell"><text class="summary-k">CPU</text><text class="summary-v">{{cpu}}</text></div><div class="summary-cell"><text class="summary-k">CONTEXT</text><text class="summary-v tiny">{{contextProfile}}</text></div><div class="summary-cell"><text class="summary-k">ACTIVE</text><text class="summary-v tiny">{{activeApp}}</text></div></div>
    <list class="feature-list"><list-item for="{{categoryFeatures}}" class="feature-row"><input type="button" class="feature-btn" value="{{$item.title}}" data-id="{{$item.id}}" onclick="featureTap"/><text class="source">{{$item.source}}</text></list-item></list>
    <div class="category-dock"><input type="button" class="dock-item" value="CTRL" onclick="catControl"/><input type="button" class="dock-item" value="APP" onclick="catApps"/><input type="button" class="dock-item" value="AI" onclick="catSmart"/><input type="button" class="dock-item" value="NET" onclick="catNetwork"/><input type="button" class="dock-item" value="SYS" onclick="catSystem"/></div>
  </div>

  <div if="{{view == 'detail'}}" class="page masterpiece-page detail-page">
    <div class="system-status-strip"><div class="status-cell"><text class="status-dot online">●</text><text class="status-label">PC</text></div><text class="status-label">MODULE</text><text class="battery-mini">{{watchBattery}}%</text></div>
    <div class="header"><input type="button" class="back-cyber" value="‹" onclick="goList"/><div class="status-area"><text class="status-title">COMMAND</text><text class="status-secure">{{commandState}}</text></div></div>
    <div class="page-header detail-header"><text class="page-title detail-title">{{selectedTitle}}</text><div class="subtitle-row"><div class="subtitle-line"></div><text class="page-subtitle">{{selectedSource}}</text><div class="subtitle-line"></div></div></div>

    <div if="{{selectedId == '1'}}" class="module-stage"><div class="metric-bars"><div class="metric-row"><text>CPU</text><div class="track"><div class="fill fcpu"></div></div><text>{{cpu}}</text></div><div class="metric-row"><text>GPU</text><div class="track"><div class="fill fgpu"></div></div><text>{{gpu}}</text></div><div class="metric-row"><text>RAM</text><div class="track"><div class="fill fram"></div></div><text>{{ram}}</text></div><text class="stage-note">{{historySummary}} • {{topProcess}}</text></div></div>
    <div if="{{selectedId == '5'}}" class="module-stage"><div class="mouse-radar"><div class="mouse-ring r1"></div><div class="mouse-ring r2"></div><div class="mouse-cross h"></div><div class="mouse-cross v"></div><div class="mouse-dot"></div></div><div class="side-stats"><text>MODE {{airMousePrecision}}</text><text>SENS {{airMouseSensitivity}}</text><text>DRAG {{airMouseDragging}}</text><text>CURVE {{airMouseCurve}}</text></div></div>
    <div if="{{selectedId == '4'}}" class="module-stage vertical"><div class="context-core"><text class="visual-big">{{contextProfile}}</text><text class="visual-sub">{{contextMode}} • {{activeApp}}</text></div><div class="chip-row"><text>{{dynamic1Label}}</text><text>{{dynamic2Label}}</text><text>{{dynamic3Label}}</text></div></div>
    <div if="{{selectedId == '6'}}" class="module-stage vertical"><div class="app-orbit"><div class="orbit-dot"></div><text class="visual-big">APP</text></div><text class="stage-note">{{appSummary}}</text></div>
    <div if="{{selectedId == '12' || selectedId == '39'}}" class="module-stage"><div class="network-radar"><div class="radar-ring rr1"></div><div class="radar-ring rr2"></div><div class="radar-sweep"></div><text class="radar-core">{{ping}}</text></div><div class="side-stats"><text>LINK {{quality}}</text><text class="wrap">{{wifiSummary}}</text></div></div>
    <div if="{{selectedId == '21' || selectedId == '54'}}" class="module-stage vertical"><div class="command-core"><div class="command-pulse"></div><text class="visual-big">{{pcState}}</text><text class="visual-sub">{{contextProfile}} • {{activeApp}}</text></div><div class="chip-row"><text>MOUSE</text><text>WINDOWS</text><text>AUDIO</text></div></div>
    <div if="{{selectedId == '26'}}" class="module-stage"><div class="motion-core"><div class="motion-ring"></div><text class="visual-big">{{motionConfidence}}%</text></div><div class="side-stats"><text>{{motionSensitivity}}</text><text>THRESH {{motionThreshold}}%</text><text>TEST {{motionTestMode}}</text></div></div>
    <div if="{{selectedId == '49'}}" class="module-stage"><div class="mini-dial"><div class="mini-ring"></div><text class="visual-big">{{masterVolume}}%</text></div><div class="side-stats"><text>{{audioOutput}}</text><text>PER-APP MIXER</text><text>OUTPUT SAFE</text></div></div>
    <div if="{{selectedId == '50'}}" class="module-stage vertical"><div class="window-stack"><div class="win w1"></div><div class="win w2"></div><div class="win w3"></div></div><text class="stage-note">{{featureData}}</text></div>
    <div if="{{selectedId == '51'}}" class="module-stage vertical"><div class="macro-flow"><div class="flow-node active">1</div><div class="flow-line"><div class="flow-pulse"></div></div><div class="flow-node">2</div><div class="flow-line"><div class="flow-pulse delay"></div></div><div class="flow-node">3</div></div><text class="stage-note">{{macroState}} • {{featureData}}</text></div>
    <div if="{{selectedId == '52'}}" class="module-stage vertical"><div class="alert-core"><div class="alert-pulse"></div><text class="visual-big">{{notificationCount}}</text><text class="visual-sub">ALERTS</text></div><text class="stage-note">{{latestNotification}}</text></div>
    <div if="{{selectedId == '53'}}" class="module-stage vertical"><div class="shield-core"><div class="shield-ring"></div><text class="visual-big">TRUST</text></div><text class="stage-note">{{trustSummary}}</text></div>
    <div if="{{selectedId == '55'}}" class="module-stage vertical"><div class="settings-core"><text class="visual-big">{{profileName}}</text><text class="visual-sub">PC REMOTE SETTINGS</text></div><text class="stage-note">{{settingsSummary}}</text></div>
    <div if="{{selectedId != '1' &amp;&amp; selectedId != '4' &amp;&amp; selectedId != '5' &amp;&amp; selectedId != '6' &amp;&amp; selectedId != '12' &amp;&amp; selectedId != '21' &amp;&amp; selectedId != '26' &amp;&amp; selectedId != '39' &amp;&amp; selectedId != '49' &amp;&amp; selectedId != '50' &amp;&amp; selectedId != '51' &amp;&amp; selectedId != '52' &amp;&amp; selectedId != '53' &amp;&amp; selectedId != '54' &amp;&amp; selectedId != '55'}}" class="module-stage vertical"><div class="generic-core"><text class="visual-big">{{visualMain}}</text><text class="visual-sub">{{visualSub}}</text></div><text class="stage-note">{{featureData}}</text></div>

    <div class="detail-actions"><input if="{{action1Label}}" type="button" class="hud-action active-state" value="{{action1Label}}" onclick="detailAction1"/><input if="{{action2Label}}" type="button" class="hud-action" value="{{action2Label}}" onclick="detailAction2"/><input if="{{action3Label}}" type="button" class="hud-action" value="{{action3Label}}" onclick="detailAction3"/><input if="{{action4Label}}" type="button" class="hud-action" value="{{action4Label}}" onclick="detailAction4"/></div>
    <div class="command-footer"><text class="command-id">{{message}}</text><input if="{{retryAllowed}}" type="button" class="retry-btn" value="RETRY" onclick="retryLast"/></div>
  </div>
</stack>
